# .env.production.example
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.production and fill in every <placeholder>.
# NEVER commit .env.production to Git.
#
# docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (managed by Compose; pgvector image) ───────────────────────────
POSTGRES_USER=rag
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=ragdb

# DATABASE_URL is built from the three variables above inside docker-compose.prod.yml
# and injected into the api/worker/migrate containers automatically.
# Do NOT set it here unless you are using a remote managed database instead.

# ── Redis ─────────────────────────────────────────────────────────────────────
# Internal Redis managed by Compose — no URL needed unless using external Redis.
# Set these only when pointing to Upstash or another external service:
# REDIS_URL=rediss://default:<PASSWORD>@<HOST>:6379
# CELERY_BROKER_URL=${REDIS_URL}
# CELERY_RESULT_BACKEND=${REDIS_URL}

# ── Application ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<generate-a-64-char-hex-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
ENVIRONMENT=production

# ── Caddy / domain ────────────────────────────────────────────────────────────
# The public domain pointing to your Oracle VM's IP (A record in DuckDNS/DNS).
API_DOMAIN=api.yourdomain.duckdns.org

# ── Embeddings & LLM ─────────────────────────────────────────────────────────
HF_TOKEN=<hugging-face-token>
HF_HOME=/app/.cache/huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=llama-3.1-8b-instant

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=8
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_CANDIDATE_LIMIT=32
# Set to false to skip local CrossEncoder/torch (saves ~400 MB RAM on 1 GB hosts)
RERANKING_ENABLED=true
MIN_GROUNDING_SCORE=0.15

# ── Storage ───────────────────────────────────────────────────────────────────
# "postgres" stores uploaded files as bytea blobs — no billing, no extra service.
STORAGE_BACKEND=postgres

# ── CORS (React frontend URL) ─────────────────────────────────────────────────
# Comma-separated list. Add your Vercel/Netlify deploy URL here.
# localhost:5173 is always included automatically for local dev.
CORS_ORIGINS=https://your-frontend.vercel.app

# ── Frontend URL (for OAuth redirect after Google login) ──────────────────────
FRONTEND_URL=https://your-frontend.vercel.app

# ── Google OAuth 2.0 (optional — leave empty to disable Google login) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# If configuring Google login, set your public HTTPS callback URL:
GOOGLE_REDIRECT_URI=https://api.yourdomain.duckdns.org/auth/google/callback

# ── Demo mode ─────────────────────────────────────────────────────────────────
# Set to true ONLY if you want to expose POST /auth/demo for public recruiter demos.
# MUST be false on any production deployment that holds real data.
DEMO_MODE=false
DEMO_USER_EMAIL=demo@rag-demo.internal
# This password is only used when creating the account; the /auth/demo endpoint
# issues a JWT directly without checking it.
DEMO_USER_PASSWORD=<strong-random-password-for-demo-account>

# ── Per-user daily caps ───────────────────────────────────────────────────────
# 0 = disabled.
DAILY_UPLOAD_LIMIT=20
DAILY_QUESTION_LIMIT=100

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=pdf,txt,md

# ── Cloudflare R2 (optional — leave blank to use Postgres bytea storage) ───────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── Logging / monitoring ──────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
