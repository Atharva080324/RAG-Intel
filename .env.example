# Managed PostgreSQL with pgvector. Use ONE provider URL.
# Supabase direct connection:
# DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?ssl=require
# Supabase transaction pooler (recommended for serverless hosts):
# DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?ssl=require&statement_cache_size=0
# Neon:
# DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<ENDPOINT>.neon.tech/neondb?ssl=require
DATABASE_URL=

# Upstash Redis TLS URL
# REDIS_URL=rediss://default:<PASSWORD>@<ENDPOINT>.upstash.io:6379
REDIS_URL=

SECRET_KEY=<generate-a-long-random-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
PGVECTOR_EXTENSION=vector

MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=pdf,txt,md
ENVIRONMENT=production

HF_TOKEN=<hugging-face-token>
HF_HOME=/tmp/huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RETRIEVAL_TOP_K=8
RERANKER_CANDIDATE_LIMIT=32
# Set to false to skip local CrossEncoder reranking entirely (torch/sentence-transformers
# are never imported, avoiding ~400 MB RSS on 1 GB hosts like Railway free tier);
# answers then use the pre-existing hybrid semantic+lexical fusion order.
RERANKING_ENABLED=true
# Below this lexical-grounding score, the API returns an evidence-based refusal.
MIN_GROUNDING_SCORE=0.15

GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=openai/gpt-oss-120b

# Google OAuth 2.0
GOOGLE_CLIENT_ID=<google-web-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Deployed Streamlit frontend URL (used for OAuth redirects back to the UI).
# In production this must be HTTPS, e.g. https://rag-streamlit.onrender.com
STREAMLIT_FRONTEND_URL=http://127.0.0.1:8501

# Comma-separated list of allowed CORS origins for the browser UI.
# In production this should be the Streamlit deployment URL, e.g.
# CORS_ORIGINS=https://rag-streamlit.onrender.com
CORS_ORIGINS=

# Storage backend for uploaded documents (zero-billing by default).
# "auto" (default) uses R2 if configured, otherwise PostgreSQL bytea blobs.
# "postgres" forces PostgreSQL bytea blobs. "r2" forces Cloudflare R2. "local" uses uploads/ dir.
STORAGE_BACKEND=auto

# Cloudflare R2 object storage for uploaded documents (OPTIONAL; S3-compatible, free tier).
# No billing required: leave these blank to store uploaded files as bytea blobs in the
# shared PostgreSQL database instead. Only fill these in if you use the "r2" backend.
# R2_ACCOUNT_ID is the 32-char Cloudflare account id; the endpoint is derived as
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
SENTRY_DSN=
LOG_LEVEL=info
